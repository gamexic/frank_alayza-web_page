    <circle class="icon-accent icon-accent--fill" cx="12" cy="12" r="1.4"/>`,
  'propuesta': `
    <path class="icon-line" d="M6 3h8l4 4v14H6z"/>
    <path class="icon-line" d="M14 3v4h4"/>
    <path class="icon-line" d="M9 12.5h6M9 16h4"/>
