  'desarrollo': `
    <path class="icon-line" d="M8.5 8 4 12l4.5 4M15.5 8 20 12l-4.5 4"/>
    <path class="icon-line" d="M13.6 6.5 10.4 17.5"/>
    <circle class="icon-accent icon-accent--fill" cx="13.8" cy="6.7" r="1.4"/>`,
  'entrega': `
    <path class="icon-line" d="M12 3c3 2.5 4.5 6 4.5 9.5L12 16l-4.5-3.5C7.5 9 9 5.5 12 3Z"/>
    <path class="icon-line" d="M9.5 14 7 17l3-1M14.5 14l2.5 3-3-1"/>
    <path class="icon-line" d="M11 19l1 2 1-2"/>
    <circle class="icon-accent icon-accent--fill" cx="12" cy="9.5" r="1.6"/>`,

  // ---------- Social (5) ----------
  'linkedin': `
    <rect class="icon-line" x="3" y="3" width="18" height="18" rx="3"/>
    <path class="icon-line" d="M7 10.5v6.5M11 17v-4.2a2.2 2.2 0 0 1 4.4 0V17"/>
    <circle class="icon-accent icon-accent--fill" cx="7" cy="7.2" r="1.2"/>`,
  'github': `
    <path class="icon-line" d="M12 2.5a9.5 9.5 0 0 0-3 18.5c.5.1.7-.2.7-.5v-1.8c-2.6.5-3.2-1.1-3.2-1.1-.4-1-1-1.3-1-1.3-.9-.6.05-.6.05-.6 1 .07 1.5 1 1.5 1 .87 1.5 2.3 1.06 2.85.8.1-.63.34-1.06.62-1.3-2.1-.24-4.3-1.05-4.3-4.67 0-1.03.37-1.87 1-2.53-.1-.25-.42-1.27.1-2.64 0 0 .8-.26 2.65 1a9.2 9.2 0 0 1 4.8 0c1.85-1.26 2.65-1 2.65-1 .52 1.37.2 2.4.1 2.64.63.66 1 1.5 1 2.53 0 3.63-2.2 4.43-4.3 4.66.35.3.65.88.65 1.78v2.64c0 .3.2.63.7.52A9.5 9.5 0 0 0 12 2.5Z"/>
    <circle class="icon-accent icon-accent--fill" cx="12" cy="20.6" r="1.2"/>`,
  'x': `
    <path class="icon-line" d="M4.5 4.5 19.5 19.5M19.5 4.5 4.5 19.5"/>
    <circle class="icon-accent icon-accent--fill" cx="4.5" cy="4.5" r="1.4"/>`,
  'instagram': `
    <rect class="icon-line" x="3" y="3" width="18" height="18" rx="5.2"/>
    <circle class="icon-line" cx="12" cy="12" r="4"/>
    <circle class="icon-accent icon-accent--fill" cx="16.6" cy="7.4" r="1.4"/>`,
  'youtube': `
    <rect class="icon-line" x="2.5" y="6" width="19" height="12" rx="3.5"/>
    <path class="icon-accent icon-accent--fill" d="M10.4 9.2v5.6L15.2 12z"/>`,

  // ---------- UI (12) ----------
  'flecha': `
    <path class="icon-line" d="M4 12h15M13 6l6 6-6 6"/>
    <circle class="icon-accent icon-accent--fill" cx="4" cy="12" r="1.4"/>`,
  'flecha-diagonal': `
    <path class="icon-line" d="M7 17 17 7M9 7h8v8"/>
    <circle class="icon-accent icon-accent--fill" cx="7" cy="17" r="1.4"/>`,
  'descarga': `
    <path class="icon-line" d="M12 3.5v10.5M8 10l4 4 4-4"/>
    <path class="icon-line" d="M5 19.5h14"/>
    <circle class="icon-accent icon-accent--fill" cx="12" cy="3.6" r="1.4"/>`,
  'menu': `
    <path class="icon-line" d="M4 7h16M4 12h16M4 17h10"/>
    <circle class="icon-accent icon-accent--fill" cx="18" cy="17" r="1.4"/>`,
  'cerrar': `
    <path class="icon-line" d="M6 6 18 18M18 6 6 18"/>
    <circle class="icon-accent icon-accent--fill" cx="18" cy="6" r="1.4"/>`,
  'play': `
    <circle class="icon-line" cx="12" cy="12" r="8.5"/>
    <path class="icon-accent icon-accent--fill" d="M10 8.3 16.2 12 10 15.7z"/>`,
  'filtro': `
    <path class="icon-line" d="M4 5.5 20 5.5 13.5 13 13.5 19 10.5 20.5 10.5 13z"/>
    <circle class="icon-accent icon-accent--fill" cx="12" cy="13" r="1.4"/>`,
  'check': `
    <path class="icon-line" d="M5 12.5 10 17.5 19.5 7"/>
    <circle class="icon-accent icon-accent--fill" cx="19.5" cy="7" r="1.4"/>`,
  'mail': `
    <rect class="icon-line" x="3" y="5" width="18" height="14" rx="2.5"/>
    <path class="icon-line" d="M4 7.5l8 5.5 8-5.5"/>
    <circle class="icon-accent icon-accent--fill" cx="12" cy="13" r="1.3"/>`,
  'pin': `
    <path class="icon-line" d="M12 21c4-5 7-8 7-11a7 7 0 1 0-14 0c0 3 3 6 7 11Z"/>
    <circle class="icon-accent icon-accent--fill" cx="12" cy="10" r="1.9"/>`,
  'reloj': `
    <circle class="icon-line" cx="12" cy="12" r="8.5"/>
    <path class="icon-line" d="M12 7.5V12l3.5 2"/>
    <circle class="icon-accent icon-accent--fill" cx="12" cy="12" r="1.3"/>`,
  'enlace-externo': `
    <path class="icon-line" d="M17 13.5V18a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h4.5"/>
    <path class="icon-line" d="M14 4h6v6M20 4l-8.5 8.5"/>
    <circle class="icon-accent icon-accent--fill" cx="20" cy="4" r="1.4"/>`,

  // ---------- Marca (3) ----------
  'nodo-red': `
    <circle class="icon-line" cx="5.5" cy="6.5" r="2"/>
    <circle class="icon-line" cx="18.5" cy="6.5" r="2"/>
    <circle class="icon-line" cx="18.5" cy="17.5" r="2"/>
    <circle class="icon-line" cx="5.5" cy="17.5" r="2"/>
    <path class="icon-line" d="M7 7.8 10.6 10.6M17 7.8 13.4 10.6M17 16.2 13.4 13.4M7 16.2 10.6 13.4"/>
    <circle class="icon-accent icon-accent--fill" cx="12" cy="12" r="2"/>`,
  'builder': `
    <rect class="icon-line" x="3.5" y="13" width="7" height="7" rx="1.2"/>
    <rect class="icon-line" x="13.5" y="13" width="7" height="7" rx="1.2"/>
    <rect class="icon-line" x="8.5" y="4" width="7" height="7" rx="1.2"/>
    <circle class="icon-accent icon-accent--fill" cx="12" cy="7.5" r="1.5"/>`,
  'growth': `
    <path class="icon-line" d="M4 20V4M4 20h16"/>
    <path class="icon-line" d="M5.5 16.5 9.5 12l3 2.5L19 6"/>
    <path class="icon-line" d="M15.5 6H19v3.5"/>
    <circle class="icon-accent icon-accent--fill" cx="19" cy="6" r="1.7"/>`,

  // ---------- Tematicos (4) ----------
  'whatsapp': `
    <path class="icon-line" d="M4.5 19.5 5.8 15.7A8 8 0 1 1 8.3 18.2z"/>
    <path class="icon-line" d="M9 12h.01M15 12h.01"/>
    <circle class="icon-accent icon-accent--fill" cx="12" cy="12" r="1.3"/>`,
  'termometro': `
    <path class="icon-line" d="M14 14.8V5a2 2 0 1 0-4 0v9.8a4 4 0 1 0 4 0Z"/>
    <path class="icon-line" d="M12 8.5v6"/>
    <circle class="icon-accent icon-accent--fill" cx="12" cy="17.5" r="1.9"/>`,
  'escalada': `
    <path class="icon-line" d="M3 20 10 6l4 7 2.5-3.5L21 20"/>
    <circle class="icon-line" cx="8" cy="14" r=".95"/>
    <circle class="icon-line" cx="11.7" cy="10.3" r=".95"/>
    <circle class="icon-accent icon-accent--fill" cx="10" cy="6" r="1.7"/>`,
  'musica': `
    <path class="icon-line" d="M4 9.5v5M8 6.5v11M12 10v4M16 4v16M20 8.5v7"/>
    <circle class="icon-accent icon-accent--fill" cx="16" cy="4" r="1.5"/>`,
};

const inner = icons[name] ??
  `<circle class="icon-line" cx="12" cy="12" r="7"/><circle class="icon-accent icon-accent--fill" cx="12" cy="12" r="2"/>`;

if (!icons[name] && import.meta.env.DEV) {
  console.warn(`[Icon.astro] icono desconocido: "${name}". Se usa fallback.`);
}

const hasLabel = typeof label === 'string' && label.length > 0;
const svgClasses = ['icon-svg', className].filter(Boolean).join(' ');
---

{chip ? (
  <span class="icon-chip" style={`--acc:${accColor};--icon-size:${size}px;`} data-accent={accent}>
    <svg
      class={svgClasses}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      role={hasLabel ? 'img' : undefined}
      aria-label={hasLabel ? label : undefined}
      aria-hidden={hasLabel ? undefined : 'true'}
      set:html={inner}
    />
  </span>
) : (
  <svg
    class={svgClasses}
    style={`--acc:${accColor};`}
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    role={hasLabel ? 'img' : undefined}
    aria-label={hasLabel ? label : undefined}
    aria-hidden={hasLabel ? undefined : 'true'}
    set:html={inner}
  />
)}

<style is:global>
  /* Estilos del set de iconos. Globales porque el markup se inyecta via set:html
     (Astro no aplica el scope a contenido inyectado). Clases especificas del set. */
  .icon-svg {
    display: inline-block;
    flex: none;
    vertical-align: middle;
    color: inherit;
  }

  .icon-line {
    stroke: currentColor;
  }

  .icon-accent {
    stroke: var(--acc, var(--gold, #fbbf24));
    opacity: 0.9;
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 0.45s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1)),
      opacity 0.45s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1));
  }

  .icon-accent--fill {
    fill: var(--acc, var(--gold, #fbbf24));
    stroke: none;
  }

  /* Micro-animacion del acento al hover del chip o de una .card ancestro */
  .icon-chip:hover .icon-accent,
  .icon-chip:focus-within .icon-accent,
  .card:hover .icon-accent,
  .card:focus-within .icon-accent {
    transform: scale(1.22);
    opacity: 1;
  }

  /* Contenedor cuadrado (chip) */
  .icon-chip {
    display: inline-grid;
    place-items: center;
    padding: calc(var(--icon-size, 24px) * 0.34);
    border-radius: 10px;
    border: 1px solid var(--hairline, rgba(255, 255, 255, 0.08));
    background: var(--surface, #16161f);
    color: var(--text, #f0f0f5);
    transition:
      box-shadow 0.45s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1)),
      border-color 0.45s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1)),
      transform 0.45s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1));
  }

  .icon-chip:hover,
  .icon-chip:focus-within {
    border-color: color-mix(in srgb, var(--acc) 45%, var(--hairline, rgba(255, 255, 255, 0.08)));
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--acc) 22%, transparent),
      0 0 22px -4px color-mix(in srgb, var(--acc) 55%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .icon-accent,
    .icon-chip {
      transition: none;
    }
    .icon-chip:hover .icon-accent,
    .icon-chip:focus-within .icon-accent,
    .card:hover .icon-accent,
    .card:focus-within .icon-accent {
      transform: none;
    }
  }
</style>
