    <path class="icon-line" d="M10.7 6.9 7.3 16.6M13.3 6.9 16.7 16.6"/>
    <circle class="icon-accent icon-accent--fill" cx="12" cy="5" r="1.2"/>`,
  'app-web-ai': `
    <rect class="icon-line" x="3" y="4.5" width="18" height="15" rx="2"/>
    <path class="icon-line" d="M3 8.5h18M5.6 6.5h.01M8 6.5h.01"/>
    <path class="icon-line" d="M12 11v5M12 13.5h3.4M12 13.5H8.6"/>
    <circle class="icon-accent icon-accent--fill" cx="12" cy="11" r="1.5"/>`,
  'web-profesional': `
    <rect class="icon-line" x="3" y="4" width="18" height="12" rx="2"/>
    <path class="icon-line" d="M9 20h6M12 16v4"/>
    <path class="icon-line" d="M10.5 7v6.6l1.7-1.7 1.1 2.4 1.3-.6-1.1-2.3 2.3-.2z"/>
    <circle class="icon-accent icon-accent--fill" cx="7" cy="8" r="1.5"/>`,
  'ciencia-datos': `
    <path class="icon-line" d="M4 20V4M4 20h16"/>
    <path class="icon-line" d="M8 20v-6M13 20v-9M18 20v-4"/>
    <circle class="icon-accent icon-accent--fill" cx="13" cy="9" r="1.7"/>`,
  'automatizacion': `
    <circle class="icon-line" cx="12" cy="12" r="4"/>
    <path class="icon-line" d="M12 4v2.6M12 17.4V20M4 12h2.6M17.4 12H20M6.34 6.34l1.84 1.84M15.82 15.82l1.84 1.84M17.66 6.34l-1.84 1.84M8.18 15.82l-1.84 1.84"/>
    <circle class="icon-accent icon-accent--fill" cx="12" cy="12" r="1.6"/>`,
  'auditoria-kpis': `
    <circle class="icon-line" cx="10.5" cy="10.5" r="6.5"/>
    <path class="icon-line" d="M15.5 15.5 20.5 20.5"/>
    <path class="icon-line" d="M7.5 11.5l2-2 1.8 1.8 2.7-3"/>
    <circle class="icon-accent icon-accent--fill" cx="14" cy="8.3" r="1.4"/>`,

  // ---------- Valores (4) ----------
  'disciplina': `
    <path class="icon-line" d="M2 19.5h20"/>
    <path class="icon-line" d="M5 19.5 11 8l3 5 2.5-3.5L21 19.5"/>
    <circle class="icon-accent icon-accent--fill" cx="11" cy="8" r="1.7"/>`,
  'claridad': `
    <path class="icon-line" d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12Z"/>
    <circle class="icon-line" cx="12" cy="12" r="3"/>
    <circle class="icon-accent icon-accent--fill" cx="12" cy="12" r="1.5"/>`,
  'impacto': `
    <circle class="icon-line" cx="12" cy="12" r="8"/>
    <circle class="icon-line" cx="12" cy="12" r="4"/>
    <circle class="icon-accent icon-accent--fill" cx="12" cy="12" r="1.7"/>`,
  'etica': `
    <path class="icon-line" d="M12 5.5v15M7.5 20.5h9M5 8h14"/>
    <path class="icon-line" d="M5 8 2.5 13h5zM19 8l2.5 5h-5z"/>
    <circle class="icon-accent icon-accent--fill" cx="12" cy="5.5" r="1.5"/>`,

  // ---------- Proceso (4) ----------
  'descubrimiento': `
    <circle class="icon-line" cx="12" cy="12" r="9"/>
