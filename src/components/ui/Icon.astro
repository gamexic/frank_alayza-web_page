---
/**
 * Icon.astro — Set de iconografia propia de Frank Alayza.
 * Linea limpia (estilo Feather) con composicion propia y el motivo nodo/circuito
 * como eco del logo. Render 100% server-side (mapa nombre -> markup), sin JS.
 *
 * Contrato (otros agentes ya codean contra esto):
 *  - name   : string (requerido)
 *  - size   : number = 24
 *  - accent : 'gold' | 'cyan' | 'purple' = 'gold'
 *  - chip   : boolean = false   (envuelve en contenedor cuadrado con glow)
 *  - label? : string            (sin label => aria-hidden)
 *
 * ViewBox 0 0 24 24, stroke-width 1.5, caps/joins round, fill none.
 * Trazo principal: clase `icon-line` (currentColor).
 * UN solo acento por icono: clase `icon-accent` (+ `icon-accent--fill` si es relleno),
 * coloreado por la prop `accent` via var(--acc).
 */
interface Props {
  name: string;
  size?: number;
  accent?: 'gold' | 'cyan' | 'purple';
  chip?: boolean;
  label?: string;
  class?: string;
}

const { name, size = 24, accent = 'gold', chip = false, label, class: className = '' } = Astro.props;

const accentColors: Record<string, string> = {
  gold: 'var(--gold, #fbbf24)',
  cyan: 'var(--cyan, #00d4ff)',
  purple: 'var(--purple, #a855f7)',
};
const accColor = accentColors[accent] ?? accentColors.gold;

// --- Mapa de iconos (39). Trazo principal `.icon-line` + UN acento `.icon-accent`. ---
const icons: Record<string, string> = {
