---
/**
 * Badge.astro — Pill tipografico en font-tech (uppercase, tracking).
 *
 * Props:
 *   tone : gold | cyan | purple | neutral (color del texto/borde/fondo translucido).
 *   size : sm | md.
 * Texto por slot.
 */
export interface Props {
  tone?: 'gold' | 'cyan' | 'purple' | 'neutral';
  size?: 'sm' | 'md';
  class?: string;
  [key: string]: unknown;
}

const { tone = 'gold', size = 'sm', class: className, ...rest } = Astro.props;
const classes = ['badge', `badge--${tone}`, `badge--${size}`, className].filter(Boolean).join(' ');
---

<span class={classes} {...rest}><slot /></span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-tech);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    line-height: 1;
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    white-space: nowrap;
  }

  .badge--sm {
    font-size: 0.68rem;
    padding: 0.32rem 0.7rem;
  }
  .badge--md {
    font-size: 0.78rem;
    padding: 0.42rem 0.9rem;
  }

  .badge--gold {
    color: var(--gold-bright);
    background: rgba(251, 191, 36, 0.1);
    border-color: rgba(251, 191, 36, 0.28);
  }
  .badge--cyan {
    color: var(--cyan-bright);
    background: rgba(0, 212, 255, 0.1);
    border-color: rgba(0, 212, 255, 0.28);
  }
  .badge--purple {
    color: #d8b4fe;
    background: rgba(168, 85, 247, 0.12);
    border-color: rgba(168, 85, 247, 0.3);
  }
  .badge--neutral {
    color: var(--text-muted);
    background: var(--surface-2);
    border-color: var(--hairline);
  }
</style>
