---
/**
 * Counter.astro — Cifra grande en font-tech con etiqueta opcional.
 *
 * El valor FINAL ya se renderiza en el HTML (no-JS y reduced-motion ven el numero
 * correcto). MotionScript (otro agente) lee data-counter/data-prefix/data-suffix
 * y anima la cifra de 0 al valor.
 *
 * Props:
 *   value  : numero final.
 *   suffix : sufijo (default '+').
 *   prefix : prefijo opcional (p.ej. '$').
 *   label  : etiqueta bajo la cifra.
 */
export interface Props {
  value: number;
  suffix?: string;
  prefix?: string;
  label?: string;
  class?: string;
  [key: string]: unknown;
}

const { value, suffix = '+', prefix = '', label, class: className, ...rest } = Astro.props;
const classes = ['counter', className].filter(Boolean).join(' ');
---

<div class={classes} {...rest}>
  <span
    class="counter__num"
    data-counter={value}
    data-prefix={prefix}
    data-suffix={suffix}
  >{prefix}{value}{suffix}</span>
  {label && <span class="counter__label">{label}</span>}
</div>

<style>
  .counter {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .counter__num {
    font-family: var(--font-tech);
    font-weight: 600;
    font-size: clamp(2.4rem, 5vw + 0.5rem, 3.6rem);
    line-height: 1;
    letter-spacing: -0.01em;
    background: var(--grad-gold);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    font-variant-numeric: tabular-nums;
  }

  .counter__label {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.4;
  }
</style>
