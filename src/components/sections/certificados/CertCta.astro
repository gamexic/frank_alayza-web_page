---
/**
 * CertCta.astro — Banda CTA final de Certificados. Momento dorado → /contacto.
 */
import Button from '~/components/ui/Button.astro';
---

<section class="cert-cta">
  <div class="container">
    <div class="cert-cta__inner reveal">
      <span class="cert-cta__glow" aria-hidden="true"></span>
      <h2 class="cert-cta__title">¿Conversamos sobre tu proyecto?</h2>
      <p class="cert-cta__lead">
        Formación aplicada a resultados reales, no diplomas en un cajón. Cuéntame tu
        reto y vemos cómo resolverlo.
      </p>
      <Button href="/contacto" variant="primary" size="lg" magnetic iconName="flecha">
        Ir a contacto
      </Button>
    </div>
  </div>
</section>

<style>
  .cert-cta {
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  .cert-cta__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.1rem;
    padding: clamp(2.5rem, 6vw, 4rem) clamp(1.5rem, 5vw, 3rem);
    background: var(--bg-raised);
    border: 1px solid color-mix(in srgb, var(--gold) 22%, var(--hairline));
    border-radius: var(--radius-lg);
    overflow: hidden;
    isolation: isolate;
  }

  .cert-cta__glow {
    position: absolute;
    inset: -40% 20% auto;
    height: 70%;
    z-index: -1;
    background: radial-gradient(ellipse at 50% 0%, rgba(251, 191, 36, 0.22) 0%, transparent 68%);
    filter: blur(8px);
    pointer-events: none;
  }

  .cert-cta__title {
    font-size: clamp(1.8rem, 3vw + 0.5rem, 2.75rem);
  }

  .cert-cta__lead {
    max-width: 48ch;
    color: var(--text-muted);
    font-size: clamp(1.02rem, 1.2vw + 0.5rem, 1.18rem);
  }

  .cert-cta__inner :global(.btn) {
    margin-top: 0.6rem;
  }
</style>
