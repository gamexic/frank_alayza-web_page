---
/**
 * ParteHumana.astro — Split asimetrico: texto (disciplina / escalada / calistenia
 * + guiño a la musica electronica) y foto de escalada (astro:assets) con parallax.
 * Acentos morados (el lado humano de la marca).
 */
import { Image } from 'astro:assets';
import Icon from '~/components/ui/Icon.astro';
import escalada from '~/assets/fotos/frank-alayza-escalada.jpeg';
---

<section class="human">
  <div class="container human__grid">
    <div class="human__text">
      <p class="eyebrow human__eyebrow reveal">Mi parte humana</p>
      <h2 class="human__title reveal" data-delay="60">Disciplina fuera de la pantalla</h2>

      <p class="human__lead reveal" data-delay="120">
        Más allá del código y los datos hay
        <span class="hk">disciplina</span>, constancia y enfoque.
      </p>
      <p class="human__body reveal" data-delay="180">
        La <span class="hk">escalada</span> y la <span class="hk">calistenia</span>
        me enseñan que los grandes logros se construyen paso a paso: cada problema
        técnico es una ruta que analizo, intento, ajusto y vuelvo a intentar hasta
        llegar a la cima. Esa mentalidad de mejora continua es la que llevo a cada
        proyecto.
      </p>

      <p class="human__music reveal" data-delay="240">
        <Icon name="musica" accent="purple" size={22} />
        <span>Y cuando cierro el editor, produzco <span class="hk">música electrónica</span>.</span>
      </p>
    </div>

    <figure class="human__figure reveal" data-delay="120">
      <div class="human__frame">
        <div class="human__parallax" data-parallax data-speed="0.1">
          <Image
            class="human__img"
            src={escalada}
            alt="Frank Alayza en una sesión de escalada"
            widths={[420, 720, 960]}
            sizes="(max-width: 900px) 90vw, 460px"
            loading="lazy"
          />
        </div>
        <span class="human__frame-glow" aria-hidden="true"></span>
      </div>
    </figure>
  </div>
</section>

<style>
  .human {
    padding-block: clamp(4rem, 9vw, 6.5rem);
  }

  .human__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }

  /* Split asimetrico en desktop: texto mas ancho, foto vertical a la derecha. */
  @media (min-width: 860px) {
    .human__grid {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }

  .human__eyebrow {
    color: var(--purple);
  }

  .human__title {
    margin-top: 0.6rem;
  }

  .human__lead {
    margin-top: 1.2rem;
    font-size: clamp(1.1rem, 1.4vw + 0.6rem, 1.35rem);
    color: var(--text);
  }

  .human__body {
    margin-top: 1rem;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 52ch;
  }

  .human__music {
    margin-top: 1.4rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1rem;
    color: var(--text);
  }

  .hk {
    color: #d8b4fe;
    font-weight: 600;
  }

  /* ---------- Figura con parallax ---------- */
  .human__figure {
    margin: 0;
  }

  .human__frame {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--hairline);
    aspect-ratio: 4 / 5;
    box-shadow: var(--shadow-card);
  }

  /* El contenedor sobresale del marco (16% arriba/abajo) para que el recorrido
     del parallax (~13% como maximo) nunca deje huecos visibles. */
  .human__parallax {
    position: absolute;
    top: -16%;
    bottom: -16%;
    left: 0;
    right: 0;
  }

  .human__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .human__frame-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(80% 60% at 50% 110%, rgba(168, 85, 247, 0.28), transparent 70%);
    mix-blend-mode: screen;
  }

  @media (max-width: 859px) {
    .human__frame {
      max-width: 440px;
      margin-inline: auto;
      width: 100%;
    }
  }
</style>
