---
/**
 * Paquetes.astro — Los 4 paquetes (packages.ts) como cards estilo pricing SIN
 * precios. El destacado (Aplicacion Web AI Native) va elevado con borde/glow
 * dorado y Badge "Mas solicitado". Cada card: tagline, descripcion, features,
 * "ideal para" y CTA -> /contacto. En movil: apilados con el destacado primero.
 */
import Section from '~/components/ui/Section.astro';
import Card from '~/components/ui/Card.astro';
import Icon from '~/components/ui/Icon.astro';
import Badge from '~/components/ui/Badge.astro';
import Button from '~/components/ui/Button.astro';
import { packages, packagesIntro } from '~/data/packages';
---

<Section
  eyebrow="Paquetes"
  title="Planes para cada etapa de tu proyecto"
  intro={packagesIntro}
  tone="base"
  width="wide"
>
  <div class="pkg-grid reveal">
    {packages.map((pkg) => (
      <Card
        class:list={['pkg-card', { 'pkg-card--featured': pkg.featured }]}
        accent={pkg.featured ? 'gold' : 'cyan'}
        interactive
      >
        {pkg.featured && pkg.badge && (
          <Badge tone="gold" size="md" class="pkg-card__badge">{pkg.badge}</Badge>
        )}

        <div class="pkg-card__head">
          <Icon
            name={pkg.icon}
            accent={pkg.featured ? 'gold' : 'cyan'}
            chip
            size={26}
          />
          <div>
            <h3 class="pkg-card__name">{pkg.name}</h3>
            <p class="pkg-card__tagline">{pkg.tagline}</p>
          </div>
        </div>

        <p class="pkg-card__desc">{pkg.description}</p>

        <ul class="pkg-card__features">
          {pkg.features.map((feature) => (
            <li class="pkg-card__feature">
              <span class="pkg-card__check" aria-hidden="true">
                <Icon name="check" accent={pkg.featured ? 'gold' : 'cyan'} size={17} />
              </span>
              <span>{feature}</span>
            </li>
          ))}
        </ul>

        <p class="pkg-card__ideal">
          <span class="pkg-card__ideal-label">Ideal para</span>
          {pkg.idealFor}
        </p>

        <div class="pkg-card__cta">
          <Button
            href={pkg.cta.href}
            variant={pkg.featured ? 'primary' : 'secondary'}
            magnetic={pkg.featured}
            iconName="flecha"
          >{pkg.cta.label}</Button>
        </div>
      </Card>
    ))}
  </div>
</Section>

<style>
  .pkg-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 3vw, 1.5rem);
  }

  @media (min-width: 680px) {
    .pkg-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1080px) {
    .pkg-grid {
      grid-template-columns: repeat(4, 1fr);
      align-items: stretch;
    }
  }

  .pkg-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .pkg-card__badge {
    align-self: flex-start;
    /* Glow dorado que respira muy suave para atraer la vista al plan destacado. */
    animation: badgePulse 3.4s var(--ease-out-expo) infinite;
    will-change: box-shadow;
  }

  @keyframes badgePulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(251, 191, 36, 0);
    }
    50% {
      box-shadow: 0 0 15px -1px rgba(251, 191, 36, 0.5);
    }
  }

  .pkg-card__head {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
  }

  .pkg-card__name {
    font-size: clamp(1.2rem, 1.4vw + 0.5rem, 1.4rem);
  }

  .pkg-card__tagline {
    margin-top: 0.25rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .pkg-card__desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .pkg-card__features {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .pkg-card__feature {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--text);
  }

  .pkg-card__check {
    display: inline-flex;
    flex: none;
    margin-top: 0.1rem;
  }

  .pkg-card__ideal {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--hairline);
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .pkg-card__ideal-label {
    display: block;
    margin-bottom: 0.35rem;
    font-family: var(--font-tech);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .pkg-card__cta {
    margin-top: 0.4rem;
  }

  .pkg-card__cta :global(.btn) {
    width: 100%;
  }

  /* Destacado: borde + glow dorado persistente */
  .pkg-card.pkg-card--featured {
    border-color: color-mix(in srgb, var(--gold) 45%, transparent);
    box-shadow:
      var(--shadow-card),
      0 0 34px -12px rgba(251, 191, 36, 0.5);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--gold) 6%, var(--surface)) 0%,
      var(--surface) 42%
    );
  }

  /* Movil: destacado primero */
  @media (max-width: 1079px) {
    .pkg-card--featured {
      order: -1;
    }
  }

  /* Desktop: destacado elevado */
  @media (min-width: 1080px) {
    .pkg-card--featured {
      transform: translateY(-10px);
    }
    .pkg-card--featured:hover,
    .pkg-card--featured:focus-within {
      transform: translateY(-14px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pkg-card--featured {
      transform: none !important;
    }
    .pkg-card__badge {
      animation: none;
    }
  }
</style>
