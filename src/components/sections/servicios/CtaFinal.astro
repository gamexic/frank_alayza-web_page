---
/**
 * CtaFinal.astro — Cierre de "Servicios". Panel con glow dorado + CTA primario
 * grande y magnetico hacia /contacto.
 */
import Button from '~/components/ui/Button.astro';
---

<section class="cta-final" aria-labelledby="cta-final-title">
  <div class="container">
    <div class="cta-final__panel reveal">
      <span class="cta-final__glow" aria-hidden="true"></span>
      <p class="eyebrow">Siguiente paso</p>
      <h2 id="cta-final-title" class="cta-final__title">
        ¿Listo para acelerar tu proyecto?
      </h2>
      <p class="cta-final__text">
        Conversemos sobre tu negocio, definamos objetivos claros y tracemos el
        camino para convertir tu idea en un resultado medible.
      </p>
      <div class="cta-final__action">
        <Button href="/contacto" variant="primary" size="lg" magnetic iconName="flecha">
          Agendar llamada estratégica
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-final {
    padding-block: clamp(3.5rem, 8vw, var(--space-step-5));
  }

  .cta-final__panel {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: clamp(2.5rem, 7vw, 4.5rem) clamp(1.5rem, 5vw, 3rem);
    border-radius: var(--radius-lg);
    border: 1px solid color-mix(in srgb, var(--gold) 30%, var(--hairline));
    background:
      radial-gradient(circle at 50% 0%, rgba(251, 191, 36, 0.1) 0%, transparent 60%),
      var(--bg-raised);
    box-shadow: 0 0 40px -20px rgba(251, 191, 36, 0.4);
  }

  .cta-final__glow {
    position: absolute;
    bottom: -60%;
    left: 50%;
    width: min(560px, 80vw);
    height: 420px;
    transform: translateX(-50%);
    background: radial-gradient(
      ellipse at center,
      rgba(251, 191, 36, 0.14) 0%,
      transparent 65%
    );
    pointer-events: none;
  }

  .cta-final__title {
    margin-top: 0.6rem;
    font-size: clamp(1.9rem, 4vw + 0.5rem, 3rem);
  }

  .cta-final__text {
    margin-top: 1rem;
    margin-inline: auto;
    max-width: 52ch;
    color: var(--text-muted);
    font-size: clamp(1rem, 1.2vw + 0.5rem, 1.15rem);
  }

  .cta-final__action {
    margin-top: var(--space-step-2);
    display: flex;
    justify-content: center;
  }
</style>
