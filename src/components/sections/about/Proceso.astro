---
/**
 * Proceso.astro (Sobre mi) — "¿En que te puedo ayudar?".
 * 4 pasos en columna con una linea conectora vertical que se dibuja por scroll
 * (relleno scrub en desktop + motion). Cada nodo se enciende al entrar en viewport.
 * Movil / sin JS / reduced-motion: linea simple ya completa. id="proceso" (ancla
 * del CTA "Conoceme" del hero).
 */
import Section from '~/components/ui/Section.astro';
import Icon from '~/components/ui/Icon.astro';
import { process, processIntro } from '~/data/process';
---

<Section
  id="proceso"
  eyebrow="Como trabajo"
  title="¿En qué te puedo ayudar?"
  intro={processIntro}
  tone="raised"
>
  <div class="proceso-vert" data-proceso>
    <div class="proceso-vert__spine" aria-hidden="true">
      <span class="proceso-vert__fill"></span>
    </div>
    <ol class="proceso-vert__steps">
      {process.map((step, i) => (
        <li class="proceso-step reveal" data-delay={i * 80} data-proceso-step>
          <span class="proceso-step__node" aria-hidden="true">
            <Icon name={step.icon} accent="cyan" size={22} />
          </span>
          <div class="proceso-step__body">
            <span class="proceso-step__label">Paso {step.step}</span>
            <h3 class="proceso-step__title">{step.title}</h3>
            <p class="proceso-step__text">{step.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</Section>

<style>
  /* La ancla #proceso vive en el <section> de Section.astro (otro scope). */
  :global(#proceso) {
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .proceso-vert {
    position: relative;
  }

  .proceso-vert__spine {
    position: absolute;
    left: 25px;
    top: 25px;
    bottom: 25px;
    width: 2px;
    transform: translateX(-50%);
    background: var(--surface-2);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  .proceso-vert__fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--cyan-bright), var(--cyan) 50%, var(--cyan-deep));
    box-shadow: 0 0 14px -2px rgba(0, 212, 255, 0.6);
    transform: scaleY(1);
    transform-origin: top center;
  }

  .proceso-vert__steps {
    display: flex;
    flex-direction: column;
    gap: clamp(1.75rem, 4vw, 2.75rem);
  }

  .proceso-step {
    display: grid;
    grid-template-columns: 50px 1fr;
    gap: clamp(1rem, 3vw, 1.5rem);
    align-items: start;
  }

  .proceso-step__node {
    position: relative;
    z-index: 1;
    width: 50px;
    height: 50px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--surface);
    border: 1px solid var(--hairline);
    color: var(--text);
    transition:
      border-color var(--dur) var(--ease-out-expo),
      box-shadow var(--dur) var(--ease-out-expo),
      transform var(--dur) var(--ease-out-expo);
  }

  .proceso-step.is-active .proceso-step__node {
    border-color: color-mix(in srgb, var(--cyan) 55%, transparent);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--cyan) 22%, transparent),
      0 0 22px -4px rgba(0, 212, 255, 0.6);
  }

  .proceso-step__label {
    display: inline-block;
    font-family: var(--font-tech);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cyan-bright);
  }

  .proceso-step__title {
    margin-top: 0.35rem;
    font-size: clamp(1.2rem, 1.6vw + 0.5rem, 1.5rem);
  }

  .proceso-step__text {
    margin-top: 0.5rem;
    max-width: 60ch;
    color: var(--text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .proceso-step__node {
      transition: none;
    }
  }
</style>

<script>
  type Cleanup = () => void;
  const procesoCleanups: Cleanup[] = [];

  function initProceso() {
    const blocks = document.querySelectorAll<HTMLElement>('[data-proceso]');
    if (!blocks.length) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    blocks.forEach((block) => {
      if (block.dataset.procesoInit === 'true') return;
      block.dataset.procesoInit = 'true';

      const steps = Array.from(
        block.querySelectorAll<HTMLElement>('[data-proceso-step]'),
      );

      // Encendido de nodos al entrar.
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-active');
              obs.unobserve(entry.target);
            });
          },
          { threshold: 0.4, rootMargin: '0px 0px -10% 0px' },
        );
        steps.forEach((s) => io.observe(s));
      } else {
        steps.forEach((s) => s.classList.add('is-active'));
      }

      // Relleno continuo de la linea (solo desktop + motion).
      const spine = block.querySelector<HTMLElement>('.proceso-vert__spine');
      const fill = block.querySelector<HTMLElement>('.proceso-vert__fill');
      const desktop = window.matchMedia('(min-width: 768px)').matches;
      if (!spine || !fill || reduce || !desktop) return;

      let ticking = false;
      const update = () => {
        ticking = false;
        if (!spine.isConnected) return;
        const rect = spine.getBoundingClientRect();
        const vh = window.innerHeight;
        const start = vh * 0.75;
        const end = vh * 0.35;
        const travel = rect.height + start - end;
        const p = Math.max(0, Math.min(1, (start - rect.top) / travel));
        fill.style.transform = `scaleY(${p})`;
      };
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      };

      fill.style.transform = 'scaleY(0)';
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      procesoCleanups.push(() => {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
      });
      update();
    });
  }

  initProceso();
  document.addEventListener('astro:page-load', initProceso);
  document.addEventListener('astro:before-swap', () => {
    while (procesoCleanups.length) procesoCleanups.pop()?.();
  });
</script>
