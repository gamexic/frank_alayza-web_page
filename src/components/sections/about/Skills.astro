---
/**
 * Skills.astro — Habilidades tecnicas por grupo con barras de nivel animadas.
 * Nivel -> ancho: advanced 90%, intermediate 65%. Gradiente cian (acento tecnico).
 * Las barras se rellenan al entrar en viewport (IntersectionObserver inline).
 * Sin JS o con reduced-motion: las barras se ven completas (sin animacion).
 */
import Section from '~/components/ui/Section.astro';
import Card from '~/components/ui/Card.astro';
import Icon from '~/components/ui/Icon.astro';
import { skills, skillsIntro } from '~/data/skills';

const levelPct: Record<string, number> = { advanced: 90, intermediate: 65 };
const levelLabel: Record<string, string> = {
  advanced: 'Avanzado',
  intermediate: 'Intermedio',
};
---

<Section
  eyebrow="Stack"
  title="Habilidades técnicas"
  intro={skillsIntro}
  tone="base"
>
  <div class="skills__grid" data-skills>
    {skills.map((group) => (
      <Card class="skills-group" accent="cyan" data-skills-group>
        <div class="skills-group__head">
          <Icon name={group.icon} accent="cyan" chip size={26} />
          <h3 class="skills-group__title">{group.title}</h3>
        </div>
        <ul class="skills-group__list">
          {group.tags.map((tag) => {
            const pct = levelPct[tag.level] ?? 60;
            return (
              <li class="skill-bar">
                <div class="skill-bar__head">
                  <span class="skill-bar__name">{tag.name}</span>
                  <span class="skill-bar__level">{levelLabel[tag.level]}</span>
                </div>
                <div class="skill-bar__track">
                  <span
                    class="skill-bar__fill"
                    style={`width:${pct}%`}
                    data-level={`${pct}%`}
                  ></span>
                </div>
              </li>
            );
          })}
        </ul>
      </Card>
    ))}
  </div>
</Section>

<style>
  .skills__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 3vw, 1.5rem);
  }

  @media (min-width: 640px) {
    .skills__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .skills__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .skills-group__head {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.35rem;
  }

  .skills-group__title {
    font-size: clamp(1.15rem, 1.4vw + 0.5rem, 1.35rem);
  }

  .skills-group__list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .skill-bar__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.45rem;
  }

  .skill-bar__name {
    font-size: 0.92rem;
    color: var(--text);
  }

  .skill-bar__level {
    font-family: var(--font-tech);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .skill-bar__track {
    height: 6px;
    border-radius: var(--radius-pill);
    background: var(--surface-2);
    overflow: hidden;
  }

  .skill-bar__fill {
    display: block;
    height: 100%;
    border-radius: var(--radius-pill);
    background: linear-gradient(90deg, var(--cyan-deep), var(--cyan) 60%, var(--cyan-bright));
    box-shadow: 0 0 12px -2px rgba(0, 212, 255, 0.5);
    transition: width 1.1s var(--ease-out-expo);
    will-change: width;
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-bar__fill {
      transition: none;
    }
  }
</style>

<script>
  function initSkillBars() {
    const grids = document.querySelectorAll<HTMLElement>('[data-skills]');
    if (!grids.length) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    grids.forEach((grid) => {
      if (grid.dataset.skillsInit === 'true') return;
      grid.dataset.skillsInit = 'true';

      const groups = Array.from(
        grid.querySelectorAll<HTMLElement>('[data-skills-group]'),
      );

      // Reduced-motion o sin IO: se dejan completas (CSS ya las pinta al 100% del nivel).
      if (reduce || !('IntersectionObserver' in window)) return;

      // Colapsar antes de observar para animar el llenado.
      grid.querySelectorAll<HTMLElement>('.skill-bar__fill').forEach((f) => {
        f.style.width = '0';
      });

      const io = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const fills = entry.target.querySelectorAll<HTMLElement>('.skill-bar__fill');
            fills.forEach((fill, i) => {
              window.setTimeout(() => {
                fill.style.width = fill.dataset.level || '0';
              }, i * 100);
            });
            obs.unobserve(entry.target);
          });
        },
        { threshold: 0.35 },
      );

      groups.forEach((g) => io.observe(g));
    });
  }

  initSkillBars();
  document.addEventListener('astro:page-load', initSkillBars);
</script>
