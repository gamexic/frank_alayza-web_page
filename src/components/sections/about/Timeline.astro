---
/**
 * Timeline.astro — Trayectoria (timeline.ts). Espina vertical con relleno que se
 * dibuja por scroll y marcadores que se encienden (glow cian) al entrar en
 * viewport. Desktop: tarjetas alternadas a ambos lados. Movil: todas a la derecha
 * de una espina a la izquierda. Sin JS / reduced-motion: espina completa.
 */
import Section from '~/components/ui/Section.astro';
import { timeline } from '~/data/timeline';
---

<Section
  eyebrow="Trayectoria"
  title="Mi ruta de formación y evolución"
  intro="Del inglés y los fundamentos de programación a construir negocios de tecnología con IA."
  tone="base"
  width="wide"
>
  <div class="timeline" data-timeline>
    <div class="timeline__spine" aria-hidden="true">
      <span class="timeline__fill"></span>
    </div>
    <ol class="timeline__items">
      {timeline.map((entry, i) => (
        <li
          class:list={[
            'timeline__item',
            i % 2 === 0 ? 'timeline__item--left' : 'timeline__item--right',
            'reveal',
          ]}
          data-timeline-item
        >
          <span class="timeline__marker" aria-hidden="true"></span>
          <article class="timeline__card">
            <span class="timeline__year">{entry.year}</span>
            <span class="timeline__period">{entry.period}</span>
            <h3 class="timeline__title">{entry.title}</h3>
            <p class="timeline__text">{entry.description}</p>
          </article>
        </li>
      ))}
    </ol>
  </div>
</Section>

<style>
  .timeline {
    position: relative;
  }

  /* --- Espina + relleno --- */
  .timeline__spine {
    position: absolute;
    left: 16px;
    top: 6px;
    bottom: 6px;
    width: 2px;
    transform: translateX(-50%);
    background: var(--surface-2);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  .timeline__fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--cyan-bright), var(--cyan) 50%, var(--cyan-deep));
    box-shadow: 0 0 14px -2px rgba(0, 212, 255, 0.6);
    transform: scaleY(1);
    transform-origin: top center;
  }

  .timeline__items {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 4vw, 2.25rem);
  }

  /* --- Movil: todo a la derecha de la espina --- */
  .timeline__item {
    position: relative;
    padding-left: 48px;
  }

  .timeline__marker {
    position: absolute;
    left: 16px;
    top: 1.6rem;
    transform: translateX(-50%);
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--surface);
    border: 2px solid var(--border);
    z-index: 1;
    transition:
      border-color var(--dur) var(--ease-out-expo),
      box-shadow var(--dur) var(--ease-out-expo),
      background-color var(--dur) var(--ease-out-expo);
  }

  .timeline__item.is-active .timeline__marker {
    border-color: var(--cyan);
    background: color-mix(in srgb, var(--cyan) 30%, var(--surface));
    box-shadow:
      0 0 0 4px color-mix(in srgb, var(--cyan) 12%, transparent),
      0 0 18px -2px rgba(0, 212, 255, 0.7);
  }

  .timeline__card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    padding: clamp(1.1rem, 3vw, 1.6rem);
    transition:
      border-color var(--dur) var(--ease-out-expo),
      box-shadow var(--dur) var(--ease-out-expo);
  }

  .timeline__item.is-active .timeline__card {
    border-color: color-mix(in srgb, var(--cyan) 26%, var(--hairline));
  }

  .timeline__year {
    display: inline-block;
    font-family: var(--font-tech);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    padding: 0.28rem 0.7rem;
    border-radius: var(--radius-pill);
    color: var(--cyan-bright);
    background: rgba(0, 212, 255, 0.1);
    border: 1px solid rgba(0, 212, 255, 0.28);
  }

  .timeline__period {
    display: block;
    margin-top: 0.7rem;
    font-family: var(--font-tech);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .timeline__title {
    margin-top: 0.35rem;
    font-size: clamp(1.2rem, 1.5vw + 0.5rem, 1.5rem);
  }

  .timeline__text {
    margin-top: 0.6rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  /* --- Desktop: alternado a ambos lados de una espina central --- */
  @media (min-width: 820px) {
    .timeline__spine {
      left: 50%;
    }

    .timeline__items {
      gap: clamp(1.5rem, 3vw, 2.25rem);
    }

    .timeline__item {
      padding-left: 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 56px;
    }

    .timeline__marker {
      left: 50%;
      top: 1.9rem;
    }

    .timeline__item--left .timeline__card {
      grid-column: 1;
      text-align: right;
    }

    .timeline__item--right .timeline__card {
      grid-column: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline__marker,
    .timeline__card {
      transition: none;
    }
  }
</style>

<script>
  type Cleanup = () => void;
  const timelineCleanups: Cleanup[] = [];

  function initTimeline() {
    const blocks = document.querySelectorAll<HTMLElement>('[data-timeline]');
    if (!blocks.length) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    blocks.forEach((block) => {
      if (block.dataset.timelineInit === 'true') return;
      block.dataset.timelineInit = 'true';

      const items = Array.from(
        block.querySelectorAll<HTMLElement>('[data-timeline-item]'),
      );

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-active');
              obs.unobserve(entry.target);
            });
          },
          { threshold: 0.35, rootMargin: '0px 0px -12% 0px' },
        );
        items.forEach((it) => io.observe(it));
      } else {
        items.forEach((it) => it.classList.add('is-active'));
      }

      const spine = block.querySelector<HTMLElement>('.timeline__spine');
      const fill = block.querySelector<HTMLElement>('.timeline__fill');
      if (!spine || !fill || reduce) return;

      let ticking = false;
      const update = () => {
        ticking = false;
        if (!spine.isConnected) return;
        const rect = spine.getBoundingClientRect();
        const vh = window.innerHeight;
        const start = vh * 0.78;
        const end = vh * 0.32;
        const travel = rect.height + start - end;
        const p = Math.max(0, Math.min(1, (start - rect.top) / travel));
        fill.style.transform = `scaleY(${p})`;
      };
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      };

      fill.style.transform = 'scaleY(0)';
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      timelineCleanups.push(() => {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
      });
      update();
    });
  }

  initTimeline();
  document.addEventListener('astro:page-load', initTimeline);
  document.addEventListener('astro:before-swap', () => {
    while (timelineCleanups.length) timelineCleanups.pop()?.();
  });
</script>
