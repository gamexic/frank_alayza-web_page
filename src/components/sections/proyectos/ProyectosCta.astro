---
/**
 * ProyectosCta.astro — Banda CTA al final de Proyectos. Momento dorado.
 */
import Button from '~/components/ui/Button.astro';
---

<section class="proyectos-cta">
  <div class="container">
    <div class="proyectos-cta__inner reveal">
      <span class="proyectos-cta__glow" aria-hidden="true"></span>
      <h2 class="proyectos-cta__title">¿Construimos algo juntos?</h2>
      <p class="proyectos-cta__lead">
        Cuéntame qué necesitas y vemos cómo llevarlo a un resultado real: un producto,
        una automatización o el negocio completo.
      </p>
      <Button href="/contacto" variant="primary" size="lg" magnetic iconName="flecha">
        Hablemos
      </Button>
    </div>
  </div>
</section>

<style>
  .proyectos-cta {
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  .proyectos-cta__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.1rem;
    padding: clamp(2.5rem, 6vw, 4rem) clamp(1.5rem, 5vw, 3rem);
    background: var(--bg-raised);
    border: 1px solid color-mix(in srgb, var(--gold) 22%, var(--hairline));
    border-radius: var(--radius-lg);
    overflow: hidden;
    isolation: isolate;
  }

  .proyectos-cta__glow {
    position: absolute;
    inset: -40% 20% auto;
    height: 70%;
    z-index: -1;
    background: radial-gradient(
      ellipse at 50% 0%,
      rgba(251, 191, 36, 0.22) 0%,
      transparent 68%
    );
    filter: blur(8px);
    pointer-events: none;
  }

  .proyectos-cta__title {
    font-size: clamp(1.8rem, 3vw + 0.5rem, 2.75rem);
  }

  .proyectos-cta__lead {
    max-width: 48ch;
    color: var(--text-muted);
    font-size: clamp(1.02rem, 1.2vw + 0.5rem, 1.18rem);
  }

  .proyectos-cta__inner :global(.btn) {
    margin-top: 0.6rem;
  }
</style>
