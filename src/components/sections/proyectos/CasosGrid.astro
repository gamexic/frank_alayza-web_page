---
/**
 * CasosGrid.astro — Casos anónimos (Problema / Enfoque / Resultado) con FilterBar.
 * Cada caso lleva data-category para el filtrado. La métrica real (+120%) se
 * destaca en dorado con Counter animado. Fuente: data/projects.ts.
 */
import Section from '~/components/ui/Section.astro';
import Card from '~/components/ui/Card.astro';
import Badge from '~/components/ui/Badge.astro';
import Counter from '~/components/ui/Counter.astro';
import FilterBar from '~/components/ui/FilterBar.astro';
import { cases, caseCategories } from '~/data/projects';

// FilterBar antepone "Todos" solo → excluimos la categoría 'all' y adaptamos la forma.
const filterOptions = caseCategories
  .filter((c) => c.id !== 'all')
  .map((c) => ({ value: c.id, label: c.label }));

// Desglosa una métrica tipo "+120%" en prefijo / número / sufijo para el Counter.
function parseMetric(metric: string): { prefix: string; value: number; suffix: string } {
  const m = metric.match(/^(\D*)(\d+)(.*)$/);
  if (!m) return { prefix: '', value: 0, suffix: '' };
  return { prefix: m[1], value: parseInt(m[2], 10), suffix: m[3] };
}
---

<Section
  id="casos"
  eyebrow="Casos"
  title="Casos en los que he trabajado"
  intro="Trabajos reales con clientes. Por confidencialidad se muestran de forma anónima: el problema, mi enfoque y el resultado."
  tone="raised"
>
  <div class="casos-filter reveal">
    <FilterBar filters={filterOptions} targetSelector=".caso-card" />
  </div>

  <div class="casos-grid reveal">
    {cases.map((c) => {
      const metric = c.metric ? parseMetric(c.metric) : null;
      return (
        <Card class="caso-card" data-category={c.category}>
          <Badge tone="cyan">{c.badge}</Badge>
          <h3 class="caso-card__title">{c.title}</h3>

          <dl class="caso-card__blocks">
            <div class="caso-card__block">
              <dt>Problema</dt>
              <dd>{c.problem}</dd>
            </div>
            <div class="caso-card__block">
              <dt>Enfoque</dt>
              <dd>{c.approach}</dd>
            </div>
            <div class="caso-card__block">
              <dt>Resultado</dt>
              <dd>{c.result}</dd>
            </div>
          </dl>

          {metric && (
            <div class="caso-card__metric">
              <Counter
                value={metric.value}
                prefix={metric.prefix}
                suffix={metric.suffix}
                label={`de aumento en ${c.metricLabel}`}
              />
            </div>
          )}
        </Card>
      );
    })}
  </div>
</Section>

<style>
  .casos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(1.1rem, 2.5vw, 1.6rem);
    align-items: start;
  }

  .caso-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    height: 100%;
  }

  .caso-card__title {
    font-size: clamp(1.2rem, 1.4vw + 0.6rem, 1.45rem);
    line-height: 1.2;
  }

  .caso-card__blocks {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .caso-card__block dt {
    font-family: var(--font-tech);
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cyan);
    margin-bottom: 0.25rem;
  }

  .caso-card__block dd {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .caso-card__metric {
    margin-top: auto;
    padding-top: 1.1rem;
    border-top: 1px solid var(--hairline);
  }
</style>
