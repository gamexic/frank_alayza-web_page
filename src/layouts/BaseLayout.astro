---
import '~/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import NeuralBackground from '~/components/global/NeuralBackground.astro';
import Header from '~/components/global/Header.astro';
import Footer from '~/components/global/Footer.astro';
import RevealScript from '~/components/global/RevealScript.astro';
import MotionScript from '~/components/global/MotionScript.astro';
import ToastHost from '~/components/ui/ToastHost.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  pageClass?: string;
  neuralDensity?: 'ambient' | 'off';
}

const siteUrl = 'https://frankalayza.me';

const {
  title = 'Frank Alayza — Builder de negocios de tecnologia con IA',
  description = 'Administrador de negocios de tecnologia y builder AI Native. Construyo y administro negocios con inteligencia artificial: agentes, automatizaciones y software con impacto real.',
  image = '/assets/og/share.jpg',
  imageAlt = 'Frank Alayza — Builder de negocios de tecnología con IA',
  canonical = new URL(Astro.url.pathname, siteUrl).href.replace(/\/$/, '') || siteUrl,
  ogType = 'website',
  pageClass = '',
  neuralDensity = 'ambient',
} = Astro.props;

const imageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;
---

<!doctype html>
<html lang="es" class={pageClass}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#06060a" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Frank Alayza" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_PE" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Extras por pagina (ej. JSON-LD Person / BlogPosting) -->
    <slot name="head" />

    <!-- Navegacion SPA con View Transitions -->
    <ClientRouter />
  </head>
  <body class={pageClass}>
    <NeuralBackground density={neuralDensity} />

    <a class="skip-link" href="#main">Saltar al contenido</a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <ToastHost />
    <RevealScript />
    <MotionScript />
  </body>
</html>

<style>
  /* El header es fijo: desplaza el contenido su altura para no taparlo. */
  main {
    padding-top: var(--header-h);
  }
</style>
