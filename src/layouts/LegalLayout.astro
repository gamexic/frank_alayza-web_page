---
/**
 * LegalLayout.astro — Plantilla para paginas legales (privacidad, terminos).
 * Construida sobre BaseLayout.
 *
 * Estructura:
 *  - Hero compacto: eyebrow + H1 + Badge "Última actualización: {updated}".
 *  - Cuerpo a 2 columnas: nav lateral sticky de anclas (desktop, generada de las
 *    secciones) + contenido con secciones numeradas (CSS counters).
 *  - En movil la nav se convierte en un <select> "Ir a la sección".
 *  - Callout de resumen opcional al inicio del contenido.
 *
 * El contenido de cada seccion se pasa como HTML (redactado por nosotros, seguro),
 * lo que permite generar la nav y la numeracion desde una unica fuente de verdad.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Badge from '~/components/ui/Badge.astro';
import Icon from '~/components/ui/Icon.astro';
import { site } from '~/data/site';

export interface LegalSection {
  id: string;
  title: string;
  /** HTML del cuerpo de la seccion (parrafos, listas). Redactado por nosotros. */
  html: string;
}

export interface Props {
  title: string;
  description: string;
  kicker: string;
  updated: string;
  lead: string;
  summary?: string[];
  sections: LegalSection[];
}

const { title, description, kicker, updated, lead, summary = [], sections } = Astro.props;
const pageTitle = `${title} – Frank Alayza`;
---

<BaseLayout title={pageTitle} description={description} pageClass="page-legal">
  <!-- Hero compacto -->
  <section class="legal-hero">
    <div class="container-wide">
      <p class="eyebrow reveal">{kicker}</p>
      <h1 class="legal-hero__title reveal">{title}</h1>
      <p class="legal-hero__lead reveal">{lead}</p>
      <div class="legal-hero__meta reveal">
        <Badge tone="gold" size="md">Última actualización: {updated}</Badge>
        <a class="legal-hero__contact" href={`mailto:${site.email}`}>
          <Icon name="mail" size={16} accent="gold" />
          <span>{site.email}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Cuerpo -->
  <section class="legal-body">
    <div class="container-wide legal-layout">
      <!-- Nav lateral (desktop) -->
      <aside class="legal-toc" aria-label="Índice de la página">
        <p class="legal-toc__title">En esta página</p>
        <nav>
          <ol class="legal-toc__list">
            {sections.map((s) => (
              <li>
                <a class="legal-toc__link" href={`#${s.id}`} data-toc-link={s.id}>
                  <span class="legal-toc__num" aria-hidden="true"></span>
                  <span class="legal-toc__text">{s.title}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </aside>

      <!-- Selector movil -->
      <div class="legal-toc-mobile">
        <label class="legal-toc-mobile__label" for="legal-toc-select">Ir a la sección</label>
        <div class="legal-toc-mobile__field">
          <select id="legal-toc-select" data-toc-select>
            {sections.map((s, i) => (
              <option value={s.id}>{String(i + 1).padStart(2, '0')} — {s.title}</option>
            ))}
          </select>
        </div>
      </div>

      <!-- Contenido -->
      <div class="legal-content">
        {summary.length > 0 && (
          <div class="legal-summary reveal">
            <h2 class="legal-summary__title">
              <Icon name="check" size={18} accent="gold" />
              Lo esencial
            </h2>
            <ul class="legal-summary__list">
              {summary.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        )}

        <div class="legal-sections">
          {sections.map((s) => (
            <article id={s.id} class="legal-section reveal" data-toc-section={s.id}>
              <h2 class="legal-section__title">{s.title}</h2>
              <div class="legal-section__body" set:html={s.html} />
            </article>
          ))}
        </div>

        <div class="legal-foot reveal">
          <p>
            ¿Dudas sobre este documento? Escríbeme a
            {' '}<a href={`mailto:${site.email}`}>{site.email}</a> o desde la
            {' '}<a href="/contacto">página de contacto</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* --- Hero --- */
  .legal-hero {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .legal-hero .eyebrow {
    margin-bottom: 0.9rem;
  }

  .legal-hero__title {
    max-width: 20ch;
  }

  .legal-hero__lead {
    margin-top: 1.1rem;
    max-width: 60ch;
    color: var(--text-muted);
    font-size: clamp(1.02rem, 1.2vw + 0.5rem, 1.2rem);
  }

  .legal-hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.4rem;
    margin-top: 1.6rem;
  }

  .legal-hero__contact {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    transition: color var(--dur) var(--ease-out-expo);
  }
  .legal-hero__contact:hover,
  .legal-hero__contact:focus-visible {
    color: var(--gold-bright);
  }

  /* --- Layout cuerpo --- */
  .legal-body {
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }

  .legal-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.75rem, 4vw, 3.5rem);
  }

  @media (min-width: 900px) {
    .legal-layout {
      grid-template-columns: 260px minmax(0, 1fr);
      align-items: start;
    }
  }

  /* --- Nav lateral (desktop) --- */
  .legal-toc {
    display: none;
  }

  @media (min-width: 900px) {
    .legal-toc {
      display: block;
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
  }

  .legal-toc__title {
    font-family: var(--font-tech);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1rem;
  }

  .legal-toc__list {
    counter-reset: toc;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    border-left: 1px solid var(--hairline);
  }

  .legal-toc__link {
    counter-increment: toc;
    display: flex;
    gap: 0.7rem;
    padding: 0.5rem 0.9rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.4;
    transition:
      color var(--dur) var(--ease-out-expo),
      border-color var(--dur) var(--ease-out-expo);
  }

  .legal-toc__num::before {
    content: counter(toc, decimal-leading-zero);
    font-family: var(--font-tech);
    font-size: 0.8rem;
    color: var(--text-faint);
    transition: color var(--dur) var(--ease-out-expo);
  }

  .legal-toc__link:hover,
  .legal-toc__link:focus-visible,
  .legal-toc__link.is-current {
    color: var(--text);
    border-left-color: var(--gold);
  }

  .legal-toc__link:hover .legal-toc__num::before,
  .legal-toc__link:focus-visible .legal-toc__num::before,
  .legal-toc__link.is-current .legal-toc__num::before {
    color: var(--gold);
  }

  /* --- Selector movil --- */
  .legal-toc-mobile {
    display: block;
  }

  @media (min-width: 900px) {
    .legal-toc-mobile {
      display: none;
    }
  }

  .legal-toc-mobile__label {
    display: block;
    font-family: var(--font-tech);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.6rem;
  }

  .legal-toc-mobile__field {
    position: relative;
  }

  .legal-toc-mobile__field select {
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    padding: 0.8rem 2.6rem 0.8rem 1rem;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-size: 0.95rem;
    cursor: pointer;
  }
  .legal-toc-mobile__field select:focus {
    outline: none;
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(251, 191, 36, 0.18);
  }
  .legal-toc-mobile__field option {
    background: var(--surface-2);
    color: var(--text);
  }
  .legal-toc-mobile__field::after {
    content: '';
    position: absolute;
    right: 1.1rem;
    top: 50%;
    width: 0.55rem;
    height: 0.55rem;
    border-right: 2px solid var(--text-muted);
    border-bottom: 2px solid var(--text-muted);
    transform: translateY(-65%) rotate(45deg);
    pointer-events: none;
  }

  /* --- Contenido --- */
  .legal-content {
    min-width: 0;
    max-width: 68ch;
  }

  /* Resumen destacado */
  .legal-summary {
    padding: clamp(1.25rem, 3vw, 1.75rem);
    margin-bottom: clamp(2rem, 5vw, 3rem);
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    box-shadow: inset 3px 0 0 -1px var(--gold);
  }

  .legal-summary__title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-tech);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1rem;
  }

  .legal-summary__list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .legal-summary__list li {
    position: relative;
    padding-left: 1.3rem;
    color: var(--text-muted);
    font-size: 0.96rem;
    line-height: 1.55;
  }

  .legal-summary__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
  }

  /* Secciones numeradas */
  .legal-sections {
    counter-reset: legal;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 3rem);
  }

  .legal-section {
    counter-increment: legal;
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  .legal-section__title {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: clamp(1.3rem, 2vw + 0.5rem, 1.7rem);
    margin-bottom: 0.9rem;
  }

  .legal-section__title::before {
    content: counter(legal, decimal-leading-zero);
    flex: none;
    font-family: var(--font-tech);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--gold);
    padding: 0.28em 0.55em;
    border: 1px solid color-mix(in srgb, var(--gold) 32%, transparent);
    border-radius: var(--radius-pill);
    background: rgba(251, 191, 36, 0.08);
    line-height: 1;
    transform: translateY(-0.15em);
  }

  /* Tipografia de lectura del cuerpo (contenido inyectado via set:html) */
  .legal-section__body :global(p) {
    color: var(--text-muted);
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .legal-section__body :global(p + p),
  .legal-section__body :global(ul),
  .legal-section__body :global(.legal-note) {
    margin-top: 1rem;
  }

  .legal-section__body :global(ul) {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .legal-section__body :global(li) {
    position: relative;
    padding-left: 1.4rem;
    color: var(--text-muted);
    font-size: 1.02rem;
    line-height: 1.7;
  }

  .legal-section__body :global(li)::before {
    content: '';
    position: absolute;
    left: 0.1rem;
    top: 0.72em;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--gold) 70%, transparent);
    transform: rotate(45deg);
  }

  .legal-section__body :global(a) {
    color: var(--text);
    border-bottom: 1px solid color-mix(in srgb, var(--gold) 45%, transparent);
    transition: color var(--dur) var(--ease-out-expo);
  }
  .legal-section__body :global(a:hover),
  .legal-section__body :global(a:focus-visible) {
    color: var(--gold-bright);
  }

  .legal-section__body :global(.legal-note) {
    padding: 0.9rem 1.1rem;
    background: var(--surface-2);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .legal-section__body :global(.legal-note strong) {
    color: var(--text);
  }

  /* Pie */
  .legal-foot {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--hairline);
    color: var(--text-muted);
    font-size: 0.96rem;
  }
  .legal-foot a {
    color: var(--text);
    border-bottom: 1px solid color-mix(in srgb, var(--gold) 45%, transparent);
    transition: color var(--dur) var(--ease-out-expo);
  }
  .legal-foot a:hover,
  .legal-foot a:focus-visible {
    color: var(--gold-bright);
  }
</style>

<script>
  function initLegalToc() {
    const select = document.querySelector<HTMLSelectElement>('[data-toc-select]');
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-toc-section]'));
    if (!sections.length) return;

    // Selector movil: navega a la seccion elegida (in-page, sin dialogos nativos).
    if (select && select.dataset.tocInit !== 'true') {
      select.dataset.tocInit = 'true';
      select.addEventListener('change', () => {
        const target = document.getElementById(select.value);
        if (!target) return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        // Refleja la seccion en el hash sin salto adicional.
        history.replaceState(null, '', `#${select.value}`);
      });
    }

    // Scroll-spy: resalta el enlace de la seccion visible.
    if (links.length && !document.body.dataset.tocSpy) {
      document.body.dataset.tocSpy = 'true';
      const byId = new Map(links.map((l) => [l.dataset.tocLink, l]));
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const id = (entry.target as HTMLElement).dataset.tocSection;
            links.forEach((l) => l.classList.remove('is-current'));
            const active = byId.get(id);
            if (active) active.classList.add('is-current');
            if (select && select.value !== id && id) select.value = id;
          });
        },
        { rootMargin: '-30% 0px -60% 0px', threshold: 0 }
      );
      sections.forEach((s) => io.observe(s));
    }
  }

  initLegalToc();
  document.addEventListener('astro:page-load', () => {
    // Reset del flag de spy entre navegaciones SPA.
    delete document.body.dataset.tocSpy;
    initLegalToc();
  });
</script>
