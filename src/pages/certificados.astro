---
/**
 * certificados.astro — Certificaciones y acreditaciones.
 * Hero compacto + banda de resumen (Counter 110+ + plataformas) + grid con
 * FilterBar + colapsable "Ver todas (+98 más)" con CV/LinkedIn + CTA.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Counter from '~/components/ui/Counter.astro';
import Badge from '~/components/ui/Badge.astro';
import CertGrid from '~/components/sections/certificados/CertGrid.astro';
import CertTodas from '~/components/sections/certificados/CertTodas.astro';
import CertCta from '~/components/sections/certificados/CertCta.astro';
import { certificatesTotal, certificatesPlatforms } from '~/data/certificates';

const title = 'Certificados – Frank Alayza';
const description = 'Certificados de Frank Alayza - Formación y acreditaciones.';

// certificatesTotal es un string ("110+"); el Counter necesita el número.
const totalValue = parseInt(certificatesTotal, 10) || 0;
---

<BaseLayout title={title} description={description} pageClass="page-certificados">
  <section class="cert-hero">
    <div class="container">
      <p class="eyebrow reveal">Formación continua</p>
      <h1 class="reveal" data-delay="60">Certificados</h1>
      <p class="cert-hero__lead reveal" data-delay="120">
        Formación y acreditaciones que respaldan mi trabajo. Aprendizaje constante,
        aplicado a proyectos reales.
      </p>

      <div class="cert-resumen reveal" data-delay="180">
        <Counter value={totalValue} suffix="+" label="certificaciones y en aumento" />
        <div class="cert-resumen__platforms">
          <span class="cert-resumen__label">Formado en</span>
          <ul class="cert-resumen__list">
            {certificatesPlatforms.map((p) => (
              <li><Badge tone="neutral" size="md">{p}</Badge></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <CertGrid />
  <CertTodas />
  <CertCta />
</BaseLayout>

<style>
  .cert-hero {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .cert-hero .eyebrow {
    margin-bottom: 0.9rem;
  }

  .cert-hero__lead {
    margin-top: 1.1rem;
    max-width: 50ch;
    color: var(--text-muted);
    font-size: clamp(1.05rem, 1.5vw + 0.5rem, 1.3rem);
  }

  .cert-resumen {
    margin-top: clamp(2rem, 5vw, 3rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(1.5rem, 5vw, 3rem);
    padding-top: clamp(1.5rem, 4vw, 2.25rem);
    border-top: 1px solid var(--hairline);
  }

  .cert-resumen__platforms {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .cert-resumen__label {
    font-family: var(--font-tech);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .cert-resumen__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
</style>
