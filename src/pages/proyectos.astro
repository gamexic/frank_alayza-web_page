---
/**
 * proyectos.astro — Página estrella del nuevo posicionamiento.
 * Hero compacto + Negocios propios (Clevun, Iceguin) + Casos anónimos + CTA.
 * JSON-LD Organization (Clevun, Iceguin con founder) en el <head>.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import JsonLd, { organizationSchemas } from '~/components/seo/JsonLd.astro';
import NegociosDestacados from '~/components/sections/proyectos/NegociosDestacados.astro';
import JuegosDesarrollados from '~/components/sections/proyectos/JuegosDesarrollados.astro';
import CasosGrid from '~/components/sections/proyectos/CasosGrid.astro';
import ProyectosCta from '~/components/sections/proyectos/ProyectosCta.astro';

const title = 'Proyectos – Frank Alayza';
const description =
  'Proyectos de Frank Alayza - Portfolio de ciencia de datos, desarrollo y emprendimiento.';
---

<BaseLayout title={title} description={description} pageClass="page-proyectos">
  <JsonLd slot="head" data={organizationSchemas()} />

  <section class="proyectos-hero">
    <div class="container">
      <p class="eyebrow reveal">Portafolio</p>
      <h1 class="reveal" data-delay="60">Proyectos</h1>
      <p class="proyectos-hero__lead reveal" data-delay="120">
        Negocios que construyo, juegos que desarrollé y casos en los que he trabajado.
      </p>
    </div>
  </section>

  <NegociosDestacados />
  <JuegosDesarrollados />
  <CasosGrid />
  <ProyectosCta />
</BaseLayout>

<style>
  .proyectos-hero {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .proyectos-hero .eyebrow {
    margin-bottom: 0.9rem;
  }

  .proyectos-hero__lead {
    margin-top: 1.1rem;
    max-width: 46ch;
    color: var(--text-muted);
    font-size: clamp(1.05rem, 1.5vw + 0.5rem, 1.3rem);
  }
</style>
