---
/**
 * index.astro — Portada premium de frankalayza.me.
 * Posicionamiento: builder de negocios de tecnologia con IA.
 * Secciones como componentes en sections/home/, importadas en orden.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import JsonLd, { personSchema, organizationSchemas } from '~/components/seo/JsonLd.astro';
import { site } from '~/data/site';

import Hero from '~/components/sections/home/Hero.astro';
import Enfoque from '~/components/sections/home/Enfoque.astro';
import QueHago from '~/components/sections/home/QueHago.astro';
import NegociosYCasos from '~/components/sections/home/NegociosYCasos.astro';
import Stack from '~/components/sections/home/Stack.astro';
import PruebaSocial from '~/components/sections/home/PruebaSocial.astro';
import ParteHumana from '~/components/sections/home/ParteHumana.astro';
import UltimosPosts from '~/components/sections/home/UltimosPosts.astro';
import CtaFinal from '~/components/sections/home/CtaFinal.astro';
---

<BaseLayout
  title="Frank Alayza — Builder de negocios de tecnología con IA"
  description={site.description}
  pageClass="page-home"
>
  <JsonLd slot="head" data={personSchema()} />
  <JsonLd slot="head" data={organizationSchemas()} />

  <Hero />
  <Enfoque />
  <QueHago />
  <NegociosYCasos />
  <Stack />
  <PruebaSocial />
  <ParteHumana />
  <UltimosPosts />
  <CtaFinal />
</BaseLayout>
