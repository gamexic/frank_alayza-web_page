---
/**
 * contacto.astro — Pagina de contacto.
 * Hero compacto + layout 2 columnas (form 60% / info 40%), apilado en movil
 * con el formulario primero. Formulario via ContactForm (FormSubmit AJAX + toasts).
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Card from '~/components/ui/Card.astro';
import ContactForm from '~/components/forms/ContactForm.astro';
import ContactInfo from '~/components/sections/contacto/ContactInfo.astro';

const title = 'Contacto – Frank Alayza';
// Descripción migrada 1:1 del sitio antiguo (paridad SEO).
const description = 'Contacto con Frank Alayza - Email, LinkedIn, GitHub.';
---

<BaseLayout title={title} description={description} pageClass="page-contacto">
  <section class="contact-hero">
    <div class="container">
      <p class="eyebrow reveal">Hablemos</p>
      <h1 class="reveal">Contacto</h1>
      <p class="contact-hero__lead reveal">
        Cuéntame tu reto de negocio, datos o IA. Te respondo con una lectura honesta
        y, si encaja, un plan claro para resolverlo.
      </p>
    </div>
  </section>

  <section class="contact-main">
    <div class="container">
      <div class="contact-grid">
        <!-- Formulario (primero en el DOM: aparece arriba en movil, a la izquierda en desktop) -->
        <div class="contact-form-col">
          <Card accent="gold" class="reveal">
            <div class="contact-form-inner">
              <h2 class="contact-form-card__title">Envíame un mensaje</h2>
              <p class="contact-form-card__hint">
                Completa el formulario y te escribo de vuelta. Respondo normalmente en 24-48 horas.
              </p>
              <ContactForm />
              <p class="contact-form-card__note">
                Al enviar aceptas la <a href="/privacidad">política de privacidad</a>.
                Tus datos solo se usan para responderte.
              </p>
            </div>
          </Card>
        </div>

        <!-- Informacion de contacto -->
        <div class="contact-info-col">
          <ContactInfo />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* --- Hero compacto --- */
  .contact-hero {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .contact-hero .eyebrow {
    margin-bottom: 0.9rem;
  }

  .contact-hero__lead {
    margin-top: 1.1rem;
    max-width: 44ch;
    color: var(--text-muted);
    font-size: clamp(1.02rem, 1.2vw + 0.5rem, 1.2rem);
  }

  /* --- Grid principal --- */
  .contact-main {
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  /* 2 columnas en desktop: form 60% / info 40% */
  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 3fr 2fr;
      align-items: start;
    }
    /* La info sticky acompana al form en pantallas altas */
    .contact-info-col {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
  }

  .contact-form-inner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .contact-form-card__title {
    font-size: clamp(1.4rem, 2.2vw, 1.75rem);
  }

  .contact-form-card__hint {
    margin-top: -0.4rem;
    color: var(--text-muted);
    font-size: 0.98rem;
  }

  .contact-form-card__note {
    font-size: 0.85rem;
    color: var(--text-faint);
    line-height: 1.55;
  }

  .contact-form-card__note a {
    color: var(--text-muted);
    border-bottom: 1px solid var(--hairline);
    transition:
      color var(--dur) var(--ease-out-expo),
      border-color var(--dur) var(--ease-out-expo);
  }

  .contact-form-card__note a:hover,
  .contact-form-card__note a:focus-visible {
    color: var(--gold-bright);
    border-color: color-mix(in srgb, var(--gold) 45%, transparent);
  }
</style>
