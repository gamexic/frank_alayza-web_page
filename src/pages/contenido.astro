---
/**
 * contenido.astro — Hub de contenido (blog).
 * Hero compacto + FilterBar por categoría + grid de todas las entradas + newsletter.
 * Orden del grid: alfabético por entry.id (estable, coincide con el orden prev/next).
 */
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/ui/Section.astro';
import FilterBar from '~/components/ui/FilterBar.astro';
import Badge from '~/components/ui/Badge.astro';
import Icon from '~/components/ui/Icon.astro';
import NewsletterForm from '~/components/forms/NewsletterForm.astro';
import { blogFilters, categoryMeta, categoryIcon } from '~/data/blog';

const posts = (await getCollection('blog')).sort((a, b) => a.id.localeCompare(b.id));

const description =
  'Ideas, tutoriales y reflexiones sobre IA aplicada, datos para negocio y la mentalidad de construir productos con impacto real.';
---

<BaseLayout title="Contenido – Frank Alayza" description={description} pageClass="page-contenido">
  <!-- Hero compacto -->
  <section class="contenido-hero">
    <div class="container">
      <p class="eyebrow reveal">Contenido</p>
      <h1 class="contenido-hero__title reveal">Ideas para construir con IA y datos</h1>
      <p class="contenido-hero__lead reveal">{description}</p>
    </div>
  </section>

  <!-- Filtros + grid -->
  <Section width="wide" class="contenido-list">
    {posts.length > 0 ? (
      <>
        <div class="reveal">
          <FilterBar filters={blogFilters} targetSelector=".blog-card" />
        </div>

        <div class="blog-grid reveal">
          {posts.map((post) => {
            const { label, accent } = categoryMeta(post.data.category);
            const icon = categoryIcon(post.data.category);
            return (
              <article class="blog-card" data-category={post.data.category} data-accent={accent}>
                <a class="blog-card__link" href={`/${post.id}`} aria-label={`Leer artículo: ${post.data.title}`}>
                  <div class="blog-card__cover" aria-hidden="true">
                    <span class="blog-card__cover-grid"></span>
                    <span class="blog-card__cover-icon">
                      <Icon name={icon} size={44} accent={accent} />
                    </span>
                  </div>
                  <div class="blog-card__body">
                    <Badge tone={accent}>{label}</Badge>
                    <h2 class="blog-card__title">{post.data.title}</h2>
                    <p class="blog-card__subtitle">{post.data.subtitle}</p>
                    <span class="blog-card__meta">
                      <span class="blog-card__readtime">
                        <Icon name="reloj" size={15} accent={accent} />
                        {post.data.readingTime} min
                      </span>
                      <span class="blog-card__more">
                        Leer
                        <Icon name="flecha" size={15} accent={accent} class="blog-card__arrow" />
                      </span>
                    </span>
                  </div>
                </a>
              </article>
            );
          })}
        </div>
      </>
    ) : (
      <p class="contenido-empty reveal">Próximamente nuevos artículos.</p>
    )}
  </Section>

  <!-- Newsletter -->
  <Section
    id="newsletter"
    tone="raised"
    align="center"
    eyebrow="Newsletter"
    title="Contenido de IA y negocio, sin spam"
    intro="Recibe los nuevos artículos y aprendizajes de construir negocios con IA, directo a tu correo. Sin ruido, solo lo útil."
  >
    <div class="newsletter-wrap reveal">
      <NewsletterForm />
      <p class="newsletter-note">Puedes darte de baja cuando quieras.</p>
    </div>
  </Section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .contenido-hero {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) clamp(1rem, 3vw, 2rem);
  }

  .contenido-hero__title {
    margin-top: 1rem;
    max-width: 18ch;
    font-size: clamp(2.4rem, 5vw + 0.5rem, 4rem);
  }

  .contenido-hero__lead {
    margin-top: 1.15rem;
    max-width: 60ch;
    color: var(--text-muted);
    font-size: clamp(1.05rem, 1.4vw + 0.5rem, 1.28rem);
    line-height: 1.6;
  }

  .contenido-empty {
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  /* ---------- Grid de tarjetas ---------- */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: clamp(1.25rem, 3vw, 1.8rem);
  }

  .blog-card {
    --card-accent: var(--gold);
    min-width: 0;
  }

  /* Acento de marca por categoría — definido en el <article> para que herede
     tanto al enlace (glow del hover) como a la portada. */
  .blog-card[data-accent='gold'] {
    --card-accent: var(--gold);
    --acc-soft: rgba(251, 191, 36, 0.16);
    --acc-line: rgba(251, 191, 36, 0.14);
  }
  .blog-card[data-accent='cyan'] {
    --card-accent: var(--cyan);
    --acc-soft: rgba(0, 212, 255, 0.16);
    --acc-line: rgba(0, 212, 255, 0.14);
  }
  .blog-card[data-accent='purple'] {
    --card-accent: var(--purple);
    --acc-soft: rgba(168, 85, 247, 0.18);
    --acc-line: rgba(168, 85, 247, 0.14);
  }

  .blog-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition:
      transform var(--dur) var(--ease-out-expo),
      border-color var(--dur) var(--ease-out-expo),
      box-shadow var(--dur) var(--ease-out-expo);
  }

  .blog-card__link:hover,
  .blog-card__link:focus-visible {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--card-accent) 42%, transparent);
    box-shadow:
      0 20px 44px -24px rgba(0, 0, 0, 0.85),
      0 0 24px -8px color-mix(in srgb, var(--card-accent) 34%, transparent);
  }

  /* Portada CSS por categoría: gradiente del acento + malla + icono propio.
     Los tokens --acc-soft / --acc-line / --card-accent los aporta .blog-card[data-accent]. */
  .blog-card__cover {
    position: relative;
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(120% 130% at 78% 12%, var(--acc-soft, rgba(251, 191, 36, 0.16)) 0%, transparent 58%),
      linear-gradient(155deg, var(--bg-raised) 0%, var(--bg-abyss) 100%);
    border-bottom: 1px solid var(--hairline);
  }

  .blog-card__cover-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--acc-line, rgba(251, 191, 36, 0.14)) 1px, transparent 1px),
      linear-gradient(90deg, var(--acc-line, rgba(251, 191, 36, 0.14)) 1px, transparent 1px);
    background-size: 34px 34px;
    -webkit-mask-image: radial-gradient(120% 120% at 78% 12%, #000 0%, transparent 68%);
    mask-image: radial-gradient(120% 120% at 78% 12%, #000 0%, transparent 68%);
    opacity: 0.55;
  }

  .blog-card__cover-icon {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 4.6rem;
    height: 4.6rem;
    border-radius: 14px;
    background: color-mix(in srgb, var(--bg-abyss) 55%, transparent);
    border: 1px solid var(--hairline);
    backdrop-filter: blur(2px);
    transition: transform var(--dur) var(--ease-out-expo);
  }

  .blog-card__link:hover .blog-card__cover-icon,
  .blog-card__link:focus-visible .blog-card__cover-icon {
    transform: translateY(-3px) scale(1.04);
  }

  /* Cuerpo */
  .blog-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: clamp(1.15rem, 3vw, 1.5rem);
    flex: 1;
  }

  .blog-card__title {
    font-size: clamp(1.15rem, 1.4vw + 0.6rem, 1.4rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .blog-card__link:hover .blog-card__title,
  .blog-card__link:focus-visible .blog-card__title {
    color: var(--gold-bright);
  }

  /* Subtítulo recortado a 2 líneas. */
  .blog-card__subtitle {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.4rem;
    font-family: var(--font-tech);
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    color: var(--text-faint);
  }

  .blog-card__readtime,
  .blog-card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .blog-card__more {
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  .blog-card__link:hover .blog-card__more,
  .blog-card__link:focus-visible .blog-card__more {
    color: var(--gold-bright);
  }

  .blog-card :global(.blog-card__arrow) {
    transition: transform var(--dur) var(--ease-out-expo);
  }
  .blog-card__link:hover :global(.blog-card__arrow),
  .blog-card__link:focus-visible :global(.blog-card__arrow) {
    transform: translateX(3px);
  }

  /* ---------- Newsletter ---------- */
  .newsletter-wrap {
    max-width: 34rem;
    margin-inline: auto;
  }

  .newsletter-note {
    margin-top: 0.75rem;
    text-align: center;
    color: var(--text-faint);
    font-size: 0.85rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-card__link:hover,
    .blog-card__link:focus-visible {
      transform: none;
    }
    .blog-card__link:hover .blog-card__cover-icon,
    .blog-card__link:focus-visible .blog-card__cover-icon,
    .blog-card__link:hover :global(.blog-card__arrow),
    .blog-card__link:focus-visible :global(.blog-card__arrow) {
      transform: none;
    }
  }
</style>
