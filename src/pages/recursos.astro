---
/**
 * recursos.astro — Recursos gratuitos.
 * Hero compacto + grupos (tarjetas "Próximamente" elegantes + YouTube real) +
 * banda newsletter que enlaza a /contenido#newsletter.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import RecursosGrupos from '~/components/sections/recursos/RecursosGrupos.astro';
import NewsletterTeaser from '~/components/sections/recursos/NewsletterTeaser.astro';

const title = 'Recursos – Frank Alayza';
const description =
  'Recursos de Frank Alayza - Checklists, plantillas, repositorios y herramientas gratuitas para ciencia de datos e IA.';
---

<BaseLayout title={title} description={description} pageClass="page-recursos">
  <section class="recursos-hero">
    <div class="container">
      <p class="eyebrow reveal">Gratis</p>
      <h1 class="reveal" data-delay="60">Recursos</h1>
      <p class="recursos-hero__lead reveal" data-delay="120">
        Checklists, plantillas, repositorios y herramientas para ciencia de datos e IA.
        Estoy preparándolos; mientras tanto, ya puedes ver el canal de YouTube.
      </p>
    </div>
  </section>

  <RecursosGrupos />
  <NewsletterTeaser />
</BaseLayout>

<style>
  .recursos-hero {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .recursos-hero .eyebrow {
    margin-bottom: 0.9rem;
  }

  .recursos-hero__lead {
    margin-top: 1.1rem;
    max-width: 52ch;
    color: var(--text-muted);
    font-size: clamp(1.05rem, 1.5vw + 0.5rem, 1.3rem);
  }
</style>
